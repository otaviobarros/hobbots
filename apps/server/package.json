{
  "name": "@hobbots/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "allow": "tsx src/allow.ts",
    "restore": "tsx src/restore-command.ts"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@hobbots/agents": "workspace:*",
    "@hobbots/api": "workspace:*",
    "@hobbots/charms": "workspace:*",
    "@hobbots/domain": "workspace:*",
    "@hobbots/inbox": "workspace:*",
    "@hobbots/orchestration": "workspace:*",
    "@hobbots/permissions": "workspace:*",
    "@hobbots/persistence": "workspace:*",
    "@hobbots/runtimes": "workspace:*",
    "@hobbots/workbench": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "exports": {
    "./main": "./src/main.ts",
    "./hub-discovery": "./src/hub-discovery.ts",
    "./installation": "./src/installation.ts",
    "./network-settings": "./src/network-settings.ts",
    "./window-key": "./src/window-key.ts",
    "./tailscale": "./src/tailscale.ts",
    "./device-token": "./src/device-token.ts"
  }
}
