---
import { CREW } from "../data/scene.ts";
import Hob from "./Hob.astro";

const aldric = CREW[0];
---

<section class="end" aria-labelledby="end-title">
  <div class="wrap body">
    <h2 id="end-title" class="h">Wake up to finished work</h2>
    <p class="lede">Free, open source, and on your computer in two minutes.</p>
    <a class="btn" href="#download">Download Hobbots</a>
  </div>
  <div class="sun" aria-hidden="true"></div>
</section>
<div class="ground" aria-hidden="true"></div>

<!-- Aldric strolls along the bottom of the screen as the page scrolls, on wide screens only. -->
{aldric && <Hob seed={aldric.seed} color={aldric.color} size={40} class="walker" />}

<div class="only-phone phonebar">
  <button type="button" class="btn2" data-video-open>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4v16l13-8z"></path></svg>
    Watch · 2:14
  </button>
  <button type="button" class="btn" data-share>Get the link</button>
</div>

<style>
  .end {
    overflow: hidden;
    padding-top: clamp(64px, 8vw, 104px);
    text-align: center;
  }
  .body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding-bottom: clamp(48px, 6vw, 80px);
  }
  h2 {
    max-width: 18ch;
    font-size: clamp(32px, 4.5vw, 52px);
    line-height: 1.08;
  }
  .sun {
    width: 96px;
    height: 96px;
    margin: 0 auto -8px;
    background: var(--color-lantern-hover);
    clip-path: polygon(
      24px 0,
      72px 0,
      72px 12px,
      84px 12px,
      84px 24px,
      96px 24px,
      96px 72px,
      84px 72px,
      84px 84px,
      72px 84px,
      72px 96px,
      24px 96px,
      24px 84px,
      12px 84px,
      12px 72px,
      0 72px,
      0 24px,
      12px 24px,
      12px 12px,
      24px 12px
    );
  }
  :global(svg.walker) {
    display: none;
  }
  @supports (animation-timeline: view()) {
    .sun {
      animation: sunrise linear both;
      animation-timeline: view();
      animation-range: entry 0% cover 50%;
    }
  }
  @supports (animation-timeline: scroll()) {
    :global(svg.walker) {
      position: fixed;
      left: 16px;
      bottom: 6px;
      z-index: 6;
      display: block;
      pointer-events: none;
      animation: stroll linear both;
      animation-timeline: scroll(root);
    }
  }
  .phonebar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 15;
    gap: 10px;
    padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
    border-top: 2px solid var(--color-line);
    background: rgb(13 12 28 / 0.94);
    backdrop-filter: blur(8px);
  }
  .phonebar .btn,
  .phonebar .btn2 {
    flex: 1 1 0;
    min-height: 48px;
    padding: 8px 10px;
    font-size: 15px;
  }
  @media (max-width: 640px) {
    :global(svg.walker) {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(svg.walker) {
      display: none;
    }
  }
  @keyframes sunrise {
    from {
      transform: translateY(90px);
    }
  }
  @keyframes stroll {
    to {
      transform: translateX(calc(100vw - 72px));
    }
  }
</style>
