---
import { CHIEF, CHIEF_PALETTE } from "@hobbots/art/chief";
import { CONTACT, GITHUB, RELEASES, REPORT } from "../data/copy.ts";
import PixelArt from "./PixelArt.astro";
---

<footer>
  <div class="wrap">
    <div class="mark">
      <PixelArt rows={CHIEF} palette={CHIEF_PALETTE} size={28} />
      <span>hobbots.app · Apache 2.0 · Free forever</span>
    </div>
    <a href={GITHUB}>GitHub</a>
    <a href={RELEASES}>Releases</a>
    <a href={REPORT}>Report a problem</a>
    <a href={`mailto:${CONTACT}`}>{CONTACT}</a>
  </div>
</footer>

<style>
  footer {
    padding-block: 32px;
    background: var(--color-deep);
    font-size: 14px;
  }
  .wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }
  .mark {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-right: auto;
    color: var(--color-label);
  }
  a {
    color: var(--color-secondary-text);
    text-decoration: none;
  }
  a:hover {
    color: var(--color-moonlight);
    text-decoration: underline;
  }
  @media (max-width: 640px) {
    footer {
      padding-bottom: 96px;
    }
  }
</style>
