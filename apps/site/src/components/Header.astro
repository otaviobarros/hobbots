---
import { CHIEF, CHIEF_PALETTE } from "@hobbots/art/chief";
import { GITHUB, NAV } from "../data/copy.ts";
import PixelArt from "./PixelArt.astro";
---

<header class="top">
  <div class="wrap bar">
    <a href="#top" class="brand">
      <PixelArt rows={CHIEF} palette={CHIEF_PALETTE} size={32} />
      <span class="pxf">Hobbots</span>
    </a>
    <nav class="only-wide links" aria-label="Sections">
      {NAV.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href={GITHUB}>GitHub</a>
    </nav>
    <a class="btn2 small only-wide" href="#download">Download</a>
    <button type="button" class="btn2 small only-phone" aria-expanded="false" aria-controls="phone-menu" data-menu>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"
        ><path d="M4 7h16M4 12h16M4 17h16"></path></svg
      >Menu
    </button>
  </div>
  <nav id="phone-menu" class="menu" aria-label="Sections" hidden data-menu-list>
    {NAV.map((link) => <a href={link.href}>{link.long}</a>)}
    <a href="#download">Download</a>
    <a href={GITHUB}>GitHub</a>
  </nav>
</header>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(13 12 28 / 0.88);
    backdrop-filter: blur(10px);
    border-bottom: 2px solid var(--color-line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-block: 10px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-right: auto;
    text-decoration: none;
  }
  .brand span {
    font-size: 21px;
    font-weight: 700;
    color: var(--color-text);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .links a {
    padding: 10px 6px;
    color: var(--color-secondary-text);
    font-size: 15px;
    text-decoration: none;
  }
  .links a:hover {
    color: var(--color-text);
  }
  .menu {
    display: flex;
    flex-direction: column;
    padding: 8px clamp(16px, 4vw, 40px) 16px;
    border-top: 2px solid var(--color-line);
  }
  .menu[hidden] {
    display: none;
  }
  .menu a {
    display: flex;
    align-items: center;
    min-height: 48px;
    border-bottom: 2px solid var(--color-line);
    color: var(--color-text);
    font-weight: 700;
    text-decoration: none;
  }
  @media (min-width: 641px) {
    .menu {
      display: none;
    }
  }
</style>
