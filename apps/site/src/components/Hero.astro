---
import { HERO, RELEASE, VIDEO } from "../data/copy.ts";
import Stage from "./Stage.astro";

const PLAY = "M7 4v16l13-8z";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap head">
    <p class="tags">
      <span class="tag new"><span class="dot"></span>{RELEASE.version} beta is out</span>
      <span class="tag">Now with memory and skills</span>
      <span class="tag">Open source · Free forever</span>
    </p>
    <h1 id="hero-title" class="h">{HERO.title}</h1>
    <p class="lede big">{HERO.lede}</p>

    <div class="only-wide ctas">
      <a class="btn" href="#download" data-pick-os="mac">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          ><path d="M12 4v11"></path><path d="m7 10 5 5 5-5"></path><path d="M5 20h14"></path></svg
        >
        Download for Mac
      </a>
      <a class="btn2" href="#download" data-pick-os="linux">Linux <span class="tag experimental">Experimental</span></a>
    </div>
    <button type="button" class="watch only-wide" data-video-open>
      <span class="watch-play cut" aria-hidden="true"
        ><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={PLAY}></path></svg></span
      >Watch Hobbots at work · {VIDEO.length}
    </button>
    <p class="only-wide note">macOS 13 or later · Ubuntu 24.04, Debian or Fedora · Works with your Claude or ChatGPT plan</p>

    <div class="only-phone phone">
      <button type="button" class="btn" data-video-open>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={PLAY}></path></svg>
        Watch Hobbots at work · {VIDEO.length}
      </button>
      <button type="button" class="btn2" data-share>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          ><path d="M4 12v7h16v-7"></path><path d="M12 3v12"></path><path d="m7 8 5-5 5 5"></path></svg
        >
        Send the link to my computer
      </button>
      <p class="note">Hobbots runs on your Mac or Linux computer, with your Claude or ChatGPT plan.</p>
    </div>
  </div>
  <div class="wrap scene">
    <Stage />
  </div>
</section>

<section class="tint works" aria-label="Works with">
  <div class="wrap">
    <span class="muted">Runs on the plan you already pay for</span>
    <span class="ai"><span class="dot"></span>Claude</span>
    <span class="ai"><span class="dot"></span>ChatGPT</span>
    <span class="ai next"><span class="dot" style="--fg: var(--color-label)"></span>Next: Gemini and local models</span>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(56px, 8vw, 104px);
    padding-bottom: clamp(40px, 6vw, 72px);
  }
  .head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    text-align: center;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 0;
  }
  .new {
    color: var(--color-mint);
  }
  h1 {
    max-width: 16ch;
    font-size: clamp(38px, 6vw, 72px);
    line-height: 1.05;
  }
  .big {
    max-width: 58ch;
    font-size: clamp(18px, 2vw, 21px);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 8px;
  }
  .experimental {
    padding: 0 6px;
    border: 2px solid currentColor;
    background: transparent;
    color: var(--color-lantern);
  }
  .watch {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 6px 12px 6px 6px;
    border: 0;
    background: transparent;
    color: var(--color-text);
    font-size: 15px;
    font-weight: 700;
  }
  .watch:hover {
    color: var(--color-lantern);
  }
  .watch-play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--color-line);
    color: var(--color-moonlight);
  }
  .note {
    margin: 0;
    font-size: 14px;
    color: var(--color-label);
  }
  .phone {
    flex-direction: column;
    gap: 12px;
    width: 100%;
    margin-top: 8px;
  }
  .phone .btn,
  .phone .btn2 {
    width: 100%;
  }
  .scene {
    margin-top: clamp(40px, 6vw, 72px);
  }
  .works {
    padding-block: 28px;
  }
  .works .wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 28px;
    font-size: 15px;
  }
  .muted {
    color: var(--color-label);
  }
  .ai {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-text);
    font-weight: 700;
  }
  .ai.next {
    color: var(--color-secondary-text);
    font-weight: 400;
  }
</style>
