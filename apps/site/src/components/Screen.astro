---
import type { ImageMetadata } from "astro";
import type { Shot } from "../data/copy.ts";

interface Props {
  shot: Shot;
  class?: string | undefined;
  /** The screenshot's width on the page, for picking the 1280 or 2560 pixel copy. */
  sizes?: string | undefined;
  /** Screens below the fold, or hidden until picked, load lazily. */
  eager?: boolean | undefined;
  /** Only the shown screen of a group is described; the rest are hidden from screen readers too. */
  hidden?: boolean | undefined;
}

// Imported, so the build names each file by its content hash and the files can be cached for good.
const files = import.meta.glob<ImageMetadata>("../assets/screens/*.webp", { eager: true, import: "default" });
const url = (name: string) => {
  const file = files[`../assets/screens/${name}.webp`];
  if (!file) throw new Error(`No screenshot named ${name} in src/assets/screens`);
  return file.src;
};

const { shot, class: className, sizes = "(max-width: 760px) 100vw, 760px", eager, hidden } = Astro.props;
const small = url(`${shot.file}-1280`);
---

<img
  class={className}
  src={small}
  srcset={`${small} 1280w, ${url(shot.file)} 2560w`}
  sizes={sizes}
  alt={shot.alt}
  width="2560"
  height="1600"
  loading={eager ? "eager" : "lazy"}
  decoding="async"
  aria-hidden={hidden ? "true" : undefined}
/>
