---
import { THEMES } from "../data/copy.ts";
import Screen from "./Screen.astro";
---

<section class="section" aria-labelledby="looks-title" data-themes>
  <div class="wrap row">
    <div class="intro words">
      <p class="lbl">Four themes</p>
      <h2 id="looks-title" class="h h2">This page wears Workshop. The app has more.</h2>
      <p class="lede">
        Workshop is the pixel world the hobs come from. Lamplight is smooth and quiet for a long working day. Each comes
        in dark and light, and you can switch any time in Settings.
      </p>
      <fieldset class="swatches">
        <legend class="sr">Theme</legend>
        {
          THEMES.map((theme, i) => (
            <button type="button" class="sw cut" aria-pressed={i === 0 ? "true" : "false"} data-theme-pick={i}>
              <i style={`background: ${theme.chip}`} />
              <span>
                <b>{theme.name}</b>
                <em>{theme.kind}</em>
              </span>
            </button>
          ))
        }
      </fieldset>
    </div>
    <div class="frame cut">
      {
        THEMES.map((theme, i) => (
          <Screen
            shot={theme}
            class:list={["shot-in", { on: i === 0 }]}
            sizes="(max-width: 760px) 100vw, 700px"
            hidden={i !== 0}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px;
  }
  .words {
    flex: 1 1 320px;
    max-width: 420px;
    gap: 16px;
  }
  .swatches {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .sw {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 56px;
    padding: 8px 12px;
    border: 2px solid var(--color-line-2);
    background: var(--color-card);
    color: var(--color-secondary-text);
    text-align: left;
  }
  .sw[aria-pressed="true"] {
    border-color: var(--color-moonlight);
    background: var(--color-line);
  }
  .sw i {
    flex: none;
    width: 28px;
    height: 28px;
    border: 2px solid var(--color-line-2);
  }
  .sw span {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .sw b {
    color: var(--color-text);
    font-size: 15px;
  }
  .sw em {
    font-size: 13px;
    font-style: normal;
  }
  .frame {
    flex: 999 1 560px;
    min-width: 0;
  }
  @media (max-width: 640px) {
    .swatches {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
