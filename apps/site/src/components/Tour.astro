---
import { SLIDES } from "../data/copy.ts";
import Screen from "./Screen.astro";
---

<section id="tour" class="section" aria-labelledby="tour-title" data-tour>
  <div class="wrap body">
    <div class="top">
      <div class="intro">
        <p class="lbl">Inside the workshop</p>
        <h2 id="tour-title" class="h h2">Planned, shared out and checked before it reaches you</h2>
        <p class="lede">
          Hobs deliver real work: they split a goal into tasks, coordinate in the open, hold themselves to your standards
          and bring you only the decisions that matter.
        </p>
      </div>
      <button type="button" class="btn2 small" data-tour-play>Pause the tour</button>
    </div>
    <fieldset class="tabs">
      <legend class="sr">Screens</legend>
      {
        SLIDES.map((slide, i) => (
          <button type="button" class="tab cut" aria-pressed={i === 0 ? "true" : "false"} data-tour-tab={i}>
            <span>{slide.name}</span>
            <i class="track" aria-hidden="true">
              <b class="fill" />
            </i>
          </button>
        ))
      }
    </fieldset>
    <div class="tour">
      <div class="frame cut" data-tour-frame>
        {
          SLIDES.map((slide, i) => (
            <Screen
              shot={slide}
              class:list={["shot-in", { on: i === 0 }]}
              sizes="(max-width: 960px) 100vw, 860px"
              eager={i === 0}
              hidden={i !== 0}
            />
          ))
        }
      </div>
      {
        SLIDES.map((slide, i) => (
          <div class="cap" hidden={i !== 0} data-tour-cap>
            <p class="lbl step">{slide.name}</p>
            <h3 class="h cap-title">{slide.title}</h3>
            <p class="lede">{slide.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .body {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 40px;
  }
  .tabs {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tab {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 6px;
    min-height: 48px;
    padding: 10px 14px 8px;
    border: 2px solid var(--color-line-2);
    background: var(--color-card);
    color: var(--color-secondary-text);
    font-size: 15px;
    font-weight: 700;
  }
  .tab:hover,
  .tab[aria-pressed="true"] {
    color: var(--color-text);
  }
  .tab[aria-pressed="true"] {
    border-color: var(--color-moonlight);
    background: var(--color-line);
  }
  .track {
    display: block;
    height: 4px;
    background: var(--color-line-2);
  }
  .fill {
    display: none;
    height: 4px;
    background: var(--color-lantern);
  }
  /* The bar under the shown tab fills while the tour plays, and stops with it. */
  [data-playing] .tab[aria-pressed="true"] .fill {
    display: block;
    animation: grow 5s linear both;
  }
  [data-playing][data-held] .tab[aria-pressed="true"] .fill {
    animation-play-state: paused;
  }
  /* The screen's slow drift stops with the tour too; the pixel wipe still finishes. */
  [data-held] :global(.shot-in.on),
  [data-tour]:not([data-playing]) :global(.shot-in.on) {
    animation-play-state: running, paused;
  }
  .tour {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }
  .frame {
    touch-action: pan-y;
  }
  .cap {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 760px;
  }
  .cap p {
    margin: 0;
  }
  .step {
    color: var(--color-moonlight);
  }
  .cap-title {
    font-size: clamp(22px, 2.6vw, 28px);
    line-height: 1.2;
  }
  @media (min-width: 960px) {
    .tour {
      grid-template-columns: minmax(0, 1fr) 300px;
      align-items: end;
    }
  }
  @media (max-width: 640px) {
    .tabs {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(-1 * clamp(16px, 4vw, 40px));
      padding-inline: clamp(16px, 4vw, 40px);
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .tab {
      flex: none;
      scroll-snap-align: start;
    }
  }
  @keyframes grow {
    from {
      width: 0;
    }
    to {
      width: 100%;
    }
  }
</style>
