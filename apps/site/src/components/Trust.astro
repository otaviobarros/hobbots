---
import { TRUST } from "../data/copy.ts";
---

<section class="section" aria-labelledby="trust-title">
  <div class="wrap body">
    <h2 id="trust-title" class="h h2">Your hobs live on your computer</h2>
    <div class="grid3">
      {
        TRUST.map((item) => (
          <div class="card item">
            <h3 class="h">{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .body {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  h2 {
    max-width: 20ch;
  }
  .item {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
  }
  h3 {
    font-size: 20px;
  }
  p {
    margin: 0;
    color: var(--color-secondary-text);
    font-size: 16px;
  }
</style>
