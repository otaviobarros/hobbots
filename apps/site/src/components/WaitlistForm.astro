---
import { TURNSTILE_SITE_KEY } from "astro:env/client";
import { CONTACT } from "../data/copy.ts";
---

<div class="waitlist" data-waitlist>
  <form data-join-form novalidate>
    <label for="waitlist-email" class="label">Get one email when yours is out</label>
    <div class="row">
      <input
        id="waitlist-email"
        name="email"
        class="inp cut"
        type="email"
        autocomplete="email"
        placeholder="you@example.com"
        aria-describedby="waitlist-error waitlist-help"
        data-email
      />
      <button class="btn2 cut" type="submit" data-submit>Tell me</button>
    </div>
    <p id="waitlist-error" role="alert" class="error" data-error></p>
    <p id="waitlist-help" class="help">
      One email when the Windows or phone app is out. No spam. To be removed, write to{" "}
      <a href={`mailto:${CONTACT}`}>{CONTACT}</a>.
    </p>
    <!-- Only bots fill this field; people never see it. -->
    <div class="trap" aria-hidden="true">
      <label>Website <input name="website" tabindex="-1" autocomplete="off" data-website /></label>
    </div>
    <!-- Turnstile shows a check here only when it is unsure the visitor is a person. -->
    <div class="turnstile" data-turnstile data-sitekey={TURNSTILE_SITE_KEY}></div>
  </form>
  <div class="joined" role="status" data-joined hidden>
    <p class="joined-title" tabindex="-1" data-joined-focus>You are on the list.</p>
    <p class="joined-body" data-joined-body></p>
    <button type="button" class="quiet" data-reset>Use a different email</button>
  </div>
</div>

<style>
  .waitlist {
    position: relative;
    width: 100%;
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  form[hidden],
  .joined[hidden] {
    display: none;
  }
  .label {
    font-size: 15px;
    color: var(--color-secondary-text);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .row .btn2 {
    flex: 1 0 auto;
  }
  .error {
    margin: 0;
    color: var(--color-rose);
    font-size: 15px;
  }
  .error:empty {
    display: none;
  }
  .help {
    margin: 0;
    font-size: 14px;
    color: var(--color-label);
  }
  .trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .turnstile:empty {
    display: none;
  }
  .joined {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .joined p {
    margin: 0;
  }
  .joined-title {
    color: var(--color-mint);
    font-weight: 700;
  }
  .joined-body {
    overflow-wrap: anywhere;
    color: var(--color-secondary-text);
    font-size: 15px;
  }
  .joined .quiet {
    align-self: flex-start;
    padding: 4px 0;
  }
</style>
