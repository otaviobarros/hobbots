---
import "@fontsource-variable/atkinson-hyperlegible-next";
import "@fontsource-variable/pixelify-sans";
import "../styles/global.css";
import Coming from "../components/Coming.astro";
import Everywhere from "../components/Everywhere.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Meta from "../components/Meta.astro";
import Roll from "../components/Roll.astro";
import Teaser from "../components/Teaser.astro";
import Trust from "../components/Trust.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#141228" />
    <Meta />
  </head>
  <body>
    <Header />
    <main id="top">
      <Hero />
      <Teaser />
      <Coming />
      <Everywhere />
      <Roll />
      <Trust />
    </main>
    <Footer />
    <script>
      import "../scripts/page.ts";
    </script>
  </body>
</html>
