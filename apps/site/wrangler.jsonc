// Cloudflare Worker for hobbots.app. Everything here is public: binding names, IDs and limits.
// Secrets such as TURNSTILE_SECRET_KEY are set with `wrangler secret put`, never in this file.
// D1 database IDs are added once the databases exist; until then the bindings work only locally.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hobbots-site",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-23",
  "assets": { "binding": "ASSETS" },
  // Console logs only. Invocation logs record request metadata, which can include the visitor's IP address.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  // The top level is local development. Bindings are not inherited, so each environment repeats them.
  "d1_databases": [{ "binding": "WAITLIST_DB", "database_name": "hobbots-waitlist-local" }],
  "ratelimits": [{ "name": "SIGNUP_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "env": {
    "staging": {
      "name": "hobbots-site-staging",
      "d1_databases": [{ "binding": "WAITLIST_DB", "database_name": "hobbots-waitlist-staging" }],
      "ratelimits": [{ "name": "SIGNUP_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }]
    },
    "production": {
      "name": "hobbots-site-production",
      "d1_databases": [{ "binding": "WAITLIST_DB", "database_name": "hobbots-waitlist-production" }],
      "ratelimits": [{ "name": "SIGNUP_LIMIT", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }]
    }
  }
}
