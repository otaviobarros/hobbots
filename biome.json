{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!docs", "!.agents/skills", "!**/routeTree.gen.ts", "!pnpm-lock.yaml", "!**/CHANGELOG.md"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["packages/domain/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**", "!effect", "!./**", "!../**"],
                    "message": "Domain code is pure and imports only effect (STD-ARCH-002)."
                  }
                ]
              }
            }
          },
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    },
    {
      "includes": ["packages/agents/src/**", "packages/orchestration/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["node:*", "@effect/*", "@anthropic-ai/*"],
                    "message": "Only adapters do I/O (STD-ARCH-004). Reach it through a port."
                  },
                  {
                    "group": ["effect/*"],
                    "message": "Use cases import only effect core. Transports and SQL belong to adapters (STD-ARCH-003)."
                  }
                ]
              }
            }
          },
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    },
    {
      "includes": ["packages/api/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["node:*", "@effect/*", "@anthropic-ai/*"],
                    "message": "Only adapters do I/O (STD-ARCH-004). Reach it through a port."
                  },
                  {
                    "group": ["react", "react-dom", "react-dom/*"],
                    "message": "The API contract holds Schemas only (STD-ARCH-001)."
                  }
                ]
              }
            }
          },
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/**", "packages/ui/src/**", "packages/art/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["node:*"],
                    "message": "Browser code cannot import Node modules (STD-ARCH-001)."
                  }
                ],
                "paths": {
                  "react": {
                    "importNames": ["forwardRef", "FC", "useMemo", "useCallback", "memo"],
                    "message": "Write components as plain functions and pass ref as a prop (STD-REACT-013). The React Compiler memoizes, so do not write useMemo, useCallback or memo (STD-REACT-010)."
                  }
                }
              }
            }
          },
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/**", "packages/ui/src/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNestedComponentDefinitions": "error"
          },
          "style": {
            "noDefaultExport": "error"
          },
          "suspicious": {
            "noExplicitAny": "error",
            "noTsIgnore": "error"
          }
        }
      }
    }
  ],
  "plugins": [
    {
      "path": "./scripts/biome/no-double-cast.grit",
      "includes": ["apps/web/src/**", "packages/ui/src/**", "!**/*.test.ts", "!**/*.test.tsx"]
    }
  ]
}
