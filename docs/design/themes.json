  "type": {
    "reading": {
      "size": "16px",
      "lineHeight": "26px",
      "weight": 400,
      "family": "sans",
      "use": "Hob replies and any long text in the transcript. Max 70ch per line."
    },
    "body": {
      "size": "15px",
      "lineHeight": "23px",
      "weight": 400,
      "family": "sans",
      "use": "UI text: rows, fields, menus, cards. Buttons use it at the skin's button-weight."
    },
    "ui": {
      "size": "14px",
      "lineHeight": "20px",
      "weight": 400,
      "family": "sans",
      "use": "Dense UI text beside body: rows, menus, search fields and tabs."
    },
    "detail": {
      "size": "13px",
      "lineHeight": "18px",
      "weight": 400,
      "family": "sans",
      "use": "Secondary lines of a row, tags, captions. 600 for emphasis."
    },
    "meta": {
      "size": "12px",
      "lineHeight": "16px",
      "weight": 400,
      "family": "sans",
      "use": "Timestamps, counts, key hints. The floor: no text below 12px anywhere, key hints and tags included (replaces the 11px --text-meta)."
    },
    "display": {
      "size": "32px",
      "lineHeight": "36px",
      "weight": 700,
      "family": "pixel",
      "use": "Empty states and onboarding titles. At most one per screen. (Lamplight sets this style in Atkinson 700 through --font-heading; Workshop in Pixelify.)"
    },
    "heading": {
      "size": "22px",
      "lineHeight": "28px",
      "weight": 600,
      "family": "pixel",
      "use": "Screen headings, in moonlight. (Lamplight sets this style in Atkinson 700 through --font-heading; Workshop in Pixelify.)"
    },
    "title": {
      "size": "18px",
      "lineHeight": "24px",
      "weight": 600,
      "family": "pixel",
      "use": "Card, panel and Quest titles; hob name in the chat header. (Lamplight sets this style in Atkinson 700 through --font-heading; Workshop in Pixelify.)"
    },
    "label": {
      "size": "14px",
      "lineHeight": "18px",
      "weight": 700,
      "letterSpacing": "0.08em",
      "family": "pixel",
      "use": "Section labels of one or two words, in label. Workshop: uppercase, +0.08em. Lamplight: sentence case, no tracking. Longer labels: detail at 600."
    },
    "code": {
      "size": "13px",
      "lineHeight": "20px",
      "weight": 400,
      "family": "mono",
      "use": "Commands, tool output, code blocks; inline code at 0.9em."
    }
  },
