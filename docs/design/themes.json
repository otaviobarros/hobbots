      "lamplight-paper": "#ffffff",
      "workshop-night": "#141228",
      "workshop-daylight": "#ffffff"
    },
    "focus-ring": {
      "use": "Keyboard focus. Lamplight: a 2px outline 2px outside. Workshop: drawn inset (2px ring, 2px ground gap) so the cut corner cannot hide it.",
