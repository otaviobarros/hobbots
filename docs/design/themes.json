    {
      "id": "lamplight-paper",
      "name": "Lamplight Paper",
      "look": "lamplight",
      "mode": "light",
      "default": false
    },
    {
      "id": "workshop-night",
      "name": "Workshop Night",
      "look": "workshop",
      "mode": "dark",
      "default": false
    },
    {
      "id": "workshop-daylight",
      "name": "Workshop Daylight",
      "look": "workshop",
      "mode": "light",
      "default": false
    }
  ],
