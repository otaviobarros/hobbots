  "shadow": {
    "shadow-menu": {
      "use": "Menus, toasts and tooltips. Lamplight: a soft lift. Workshop: a hard pixel drop.",
      "lamplight-dusk": "0 6px 18px rgba(0, 0, 0, 0.28)",
      "lamplight-paper": "0 6px 18px rgba(40, 30, 20, 0.12)",
      "workshop-night": "0 6px 0 #0d0c1c",
      "workshop-daylight": "0 4px 0 #cfc4ae"
    },
    "shadow-sheet": {
      "use": "The work sheet over the chat.",
      "lamplight-dusk": "0 16px 48px rgba(0, 0, 0, 0.28)",
      "lamplight-paper": "0 16px 48px rgba(40, 30, 20, 0.14)",
      "workshop-night": "-14px 0 34px rgba(0, 0, 0, 0.5)",
      "workshop-daylight": "-14px 0 34px rgba(36, 31, 51, 0.14)"
    }
  },
  "fixed": {
    "switch-knob": {
      "use": "The knob of a switch that is on, in every theme.",
      "value": "#fdf9ef"
    },
    "provider-ink": {
      "use": "The letter on an AI provider's tile. The tiles are fixed pastels, so the ink is fixed too.",
      "value": "#141228"
    },
    "shadow-segment": {
      "use": "The lift under the picked segment of a segmented control.",
      "value": "0 1px 2px rgb(0 0 0 / 0.18)"
    },
    "stand-shadow": {
      "use": "The soft shadow under a standing hob.",
      "value": "rgb(0 0 0 / 0.28)"
    }
  },
