{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "treatConfigHintsAsErrors": true,
  "workspaces": {
    ".": {
      // Maintainer scripts run by hand; see docs/contributing/issues-and-board.md.
      "entry": ["scripts/*.mjs"]
    },
    "apps/desktop": {
      // Passed to electron-builder with --config, so its plugin does not find it.
      "entry": ["electron-builder.config.mjs"]
    },
    "apps/web": {
      // The window frame, which app-frame-plugin.ts loads by path to render it into index.html.
      "entry": ["src/components/shell/app-frame.tsx"],
      // The Quest room's lanes (#905), until the room that mounts them lands (#903).
      "ignore": ["src/components/lanes/**"]
    },
    "apps/site": {
      // `cloudflare:workers` is a module of the Workers runtime, not a package.
      "ignoreDependencies": ["cloudflare"]
    }
  },
  // System tools: the icon script calls iconutil (macOS) and a runtimes test calls mkfifo.
  "ignoreBinaries": ["iconutil", "mkfifo"]
}
