{
  "name": "hobbots",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --ui=tui --filter=@hobbots/server --filter=@hobbots/web",
    "dev:desktop": "turbo run dev --ui=tui --filter=@hobbots/desktop --filter=@hobbots/web",
    "build": "turbo run build",
    "package:mac": "turbo run build --filter=@hobbots/web --filter=@hobbots/desktop && pnpm --filter @hobbots/desktop package:mac",
    "package:linux": "turbo run build --filter=@hobbots/web --filter=@hobbots/desktop && pnpm --filter @hobbots/desktop package:linux",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=4",
    "test:pg": "node scripts/test-pg.mjs",
    "test:e2e": "turbo run test:e2e --filter=@hobbots/web",
    "pg:up": "docker compose -f infrastructure/local/compose.yaml up --detach --wait",
    "pg:down": "docker compose -f infrastructure/local/compose.yaml down",
    "check:standards": "node scripts/check-standards.mjs",
    "lint": "biome check .",
    "lint:unused": "knip",
    "lint:dup": "jscpd",
    "lint:layers": "node scripts/check-layers.mjs",
    "lint:complexity": "node scripts/check-complexity.mjs",
    "lint:frontend": "node scripts/check-frontend.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "format": "biome check --write .",
    "check": "turbo run check:standards lint:layers lint:complexity lint:frontend test:scripts lint:unused lint:dup lint typecheck test --concurrency=4"
  },
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "jscpd": "5.4.2",
    "knip": "6.44.0",
    "oxc-parser": "0.156.0",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=26.13"
  },
  "license": "Apache-2.0"
}
