{
  "name": "hobbots",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@hobbots/server --filter=@hobbots/web",
    "dev:desktop": "turbo run dev --filter=@hobbots/desktop --filter=@hobbots/web",
    "build": "turbo run build",
    "package:mac": "turbo run build --filter=@hobbots/web --filter=@hobbots/desktop && pnpm --filter @hobbots/desktop package:mac",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:pg": "node scripts/test-pg.mjs",
    "test:e2e": "pnpm --filter @hobbots/web build && pnpm --filter @hobbots/web test:e2e",
    "pg:up": "docker compose -f infrastructure/local/compose.yaml up --detach --wait",
    "pg:down": "docker compose -f infrastructure/local/compose.yaml down",
    "lint": "biome check .",
    "lint:unused": "knip",
    "lint:dup": "jscpd",
    "lint:complexity": "node scripts/check-complexity.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "format": "biome check --write .",
    "check": "node scripts/check-standards.mjs && node scripts/check-complexity.mjs && node --test \"scripts/*.test.mjs\" && knip && jscpd && biome check . && turbo run typecheck test"
  },
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "jscpd": "5.4.2",
    "knip": "6.44.0",
    "oxc-parser": "0.156.0",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "Apache-2.0"
}
