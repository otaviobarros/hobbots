{
  "name": "hobbots",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@hobbots/server --filter=@hobbots/web",
    "dev:desktop": "turbo run dev --filter=@hobbots/desktop --filter=@hobbots/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:pg": "node scripts/test-pg.mjs",
    "pg:up": "docker compose -f infrastructure/local/compose.yaml up --detach --wait",
    "pg:down": "docker compose -f infrastructure/local/compose.yaml down",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome check . && turbo run typecheck test"
  },
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^26.6.5",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "Apache-2.0"
}
