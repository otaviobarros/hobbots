{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", ".node-version"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": ["dist/**", "out/**"]
    },
    "@hobbots/site#build": {
      "dependsOn": ["^build"],
      "env": ["CLOUDFLARE_ENV", "TURNSTILE_SITE_KEY"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": ["dist/**", ".wrangler/deploy/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"]
    },
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"]
    },
    "test": {
      "dependsOn": ["transit"],
      "env": ["CI", "HOBBOTS_TEST_DB", "HOBBOTS_TEST_DATABASE_URL", "HOBBOTS_MEMORY_CONTRACT"],
      "passThroughEnv": ["HOBBOTS_MEMORY_ENGINE_DIR", "VITEST_MAX_WORKERS"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"]
    },
    "@hobbots/web#test:e2e": {
      "description": "Browser tests: the web build against hubs started from the server's code and its packages.",
      "dependsOn": ["build", "^transit", "@hobbots/server#transit"],
      "env": ["CI", "HOBBOTS_E2E_SHARD"],
      "passThroughEnv": ["HOBBOTS_E2E_PORT", "PLAYWRIGHT_BROWSERS_PATH"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "//#check:standards": {},
    "//#lint": {},
    "//#lint:unused": {},
    "//#lint:dup": {},
    "//#lint:layers": {},
    "//#lint:complexity": {},
    "//#lint:frontend": {},
    "//#lint:state": {},
    "//#lint:machines": {},
    "//#lint:glossary": {},
    "//#test:scripts": {},
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["HOBBOTS_*"]
    },
    "@hobbots/server#dev": {
      "dependsOn": ["@hobbots/web#build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["HOBBOTS_*"]
    },
    "@hobbots/desktop#dev": {
      "dependsOn": ["@hobbots/web#build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["HOBBOTS_*"]
    }
  }
}
